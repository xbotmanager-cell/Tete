# FRAMEX_API_KEY: Server-side API key for https://framex.wolvarex.com/api (never expose with VITE_ prefix).
FRAMEX_API_KEY=""

# DATABASE_URL: PostgreSQL connection string (e.g. Supabase Transaction/Session Pooler URL) for persistent accounts & library.
DATABASE_URL=""

# SESSION_SECRET: High-entropy random secret (at least 32 chars) used to sign HTTP-only session cookies.
SESSION_SECRET=""

# APP_URL: Canonical production URL (e.g. https://your-app.vercel.app). Optional on Vercel where VERCEL_URL is set automatically.
APP_URL=""

# GEMINI_API_KEY: Optional Gemini API key if AI features are enabled server-side.
GEMINI_API_KEY=""
